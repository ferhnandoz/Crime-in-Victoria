{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of criminal incidents by council (circle size) and change in rate since 2017 (colour).",
  "hconcat": [
    {
      "title": "Regional Victoria (Melbourne shaded, see zoom)",
      "width": 440,
      "height": 300,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/vic_lga.topojson",
            "format": {
              "type": "topojson",
              "feature": "lga"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.lga",
              "as": "lga"
            },
            {
              "lookup": "lga",
              "from": {
                "data": {
                  "url": "data/lga.csv"
                },
                "key": "lga",
                "fields": [
                  "region",
                  "incidents",
                  "rate",
                  "rate_2017",
                  "change_pct",
                  "irsd_score",
                  "disadvantage",
                  "bivar",
                  "metro",
                  "unsolved_pct"
                ]
              }
            },
            {
              "calculate": "(datum.metro == 'True' || datum.metro == true) ? 1 : 0",
              "as": "m"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 0.7
          },
          "encoding": {
            "fill": {
              "condition": {
                "test": "datum.m == 1 && true",
                "value": "#d5cfc2"
              },
              "value": "#ebe6db"
            }
          }
        },
        {
          "data": {
            "url": "data/lga.csv"
          },
          "transform": [
            {
              "lookup": "lga",
              "from": {
                "data": {
                  "url": "data/vic_lga_centroids.csv"
                },
                "key": "lga",
                "fields": [
                  "lon",
                  "lat"
                ]
              }
            },
            {
              "filter": "!(datum.metro == 'True' || datum.metro == true)"
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "#ffffff",
            "strokeWidth": 0.8,
            "opacity": 0.88
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "incidents",
              "type": "quantitative",
              "title": "Incidents recorded",
              "scale": {
                "range": [
                  8,
                  1600
                ],
                "domain": [
                  0,
                  33128
                ]
              },
              "legend": {
                "values": [
                  1000,
                  10000,
                  30000
                ],
                "labelExpr": "format(datum.value, ',')",
                "orient": "top",
                "symbolFillColor": "#bbb5a8",
                "symbolStrokeColor": "#ffffff"
              }
            },
            "color": {
              "field": "change_pct",
              "type": "quantitative",
              "title": "Change in rate since 2017 (%)",
              "scale": {
                "domain": [
                  -30,
                  0,
                  30
                ],
                "range": [
                  "#2c5a8c",
                  "#d8d3c8",
                  "#b3261e"
                ],
                "clamp": true,
                "interpolate": "rgb"
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "gradientLength": 140,
                "values": [
                  -30,
                  -15,
                  0,
                  15,
                  30
                ],
                "format": "+d"
              }
            },
            "order": {
              "field": "incidents",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "lga",
                "title": "Council"
              },
              {
                "field": "incidents",
                "title": "Incidents",
                "format": ","
              },
              {
                "field": "rate",
                "title": "Per 100,000 people",
                "format": ",.0f"
              },
              {
                "field": "change_pct",
                "title": "Rate change since 2017 (%)",
                "format": "+.0f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/lga.csv"
          },
          "transform": [
            {
              "lookup": "lga",
              "from": {
                "data": {
                  "url": "data/vic_lga_centroids.csv"
                },
                "key": "lga",
                "fields": [
                  "lon",
                  "lat"
                ]
              }
            },
            {
              "filter": "!(datum.metro == 'True' || datum.metro == true)"
            },
            {
              "filter": {
                "field": "lga",
                "oneOf": [
                  "Greater Geelong",
                  "Ballarat",
                  "Greater Bendigo",
                  "Latrobe",
                  "Mildura",
                  "Greater Shepparton"
                ]
              }
            }
          ],
          "mark": {
            "type": "text",
            "fontWeight": 700,
            "fontSize": 11.5,
            "dy": -2,
            "color": "#1d2433",
            "stroke": "#ffffff",
            "strokeWidth": 3,
            "strokeOpacity": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lga"
            }
          }
        },
        {
          "data": {
            "url": "data/lga.csv"
          },
          "transform": [
            {
              "lookup": "lga",
              "from": {
                "data": {
                  "url": "data/vic_lga_centroids.csv"
                },
                "key": "lga",
                "fields": [
                  "lon",
                  "lat"
                ]
              }
            },
            {
              "filter": "!(datum.metro == 'True' || datum.metro == true)"
            },
            {
              "filter": {
                "field": "lga",
                "oneOf": [
                  "Greater Geelong",
                  "Ballarat",
                  "Greater Bendigo",
                  "Latrobe",
                  "Mildura",
                  "Greater Shepparton"
                ]
              }
            }
          ],
          "mark": {
            "type": "text",
            "fontWeight": 700,
            "fontSize": 11.5,
            "dy": -2,
            "color": "#1d2433"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lga"
            }
          }
        }
      ]
    },
